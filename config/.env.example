# ==================================================
# BigBlueButton — VKU Center Configuration
# ==================================================

# --- BBB Server ---
BBB_DOMAIN=bbb.your-domain.com
BBB_SECRET=your_bbb_secret_here

# --- Google Drive Recording Backup ---
# Service Account JSON key file path
GDRIVE_SERVICE_ACCOUNT_KEY=/opt/bbb/config/gdrive-service-account.json
# Folder ID trên Google Drive để upload recording
GDRIVE_FOLDER_ID=your_google_drive_folder_id
# Giữ recording local bao nhiêu ngày trước khi xóa (sau khi đã upload)
RECORDING_KEEP_LOCAL_DAYS=3

# --- LMS Integration ---
LMS_CALLBACK_URL=https://your-lms-domain.com/api/bbb/webhook

# --- Branding ---
CENTER_NAME=VKU Center
HOTLINE_NUMBER=0236.xxxx.xxx
SUPPORT_EMAIL=support@your-domain.com
